@page "/"
@inject CieApi Api
@inject NavigationManager Nav

<PageTitle>@(CompanyParam ?? "Choose a company") · Complaint Intelligence</PageTitle>

@if (error is not null)
{
    <div class="notice error" role="alert">@error</div>
}

@if (CompanyParam is null)
{
    <section class="company-picker">
        <p class="eyebrow">Complaint Intelligence</p>
        <h1>Which company are you inspecting?</h1>
        <p class="lede">Choose a company to review its complaint signals, ticket drafts, and similar complaints.</p>
        <div class="field company-field">
            <label for="company-filter">Find a company</label>
            <input id="company-filter" @bind="companyFilter" @bind:event="oninput"
                   placeholder="Filter by company name" autocomplete="off" />
        </div>
        <div class="company-list-toolbar">
            <span class="muted">@FilteredCompanies.Count.ToString("N0") companies shown</span>
            <label for="company-order">Order by</label>
            <select id="company-order" @bind="companyOrder">
                <option value="most">Most complaints</option>
                <option value="fewest">Fewest complaints</option>
                <option value="name">Company name</option>
            </select>
        </div>
        @if (companies.Count == 0 && error is null)
        {
            <p class="muted">Loading companies…</p>
        }
        else if (FilteredCompanies.Count == 0)
        {
            <p class="muted">No companies match that name.</p>
        }
        else
        {
            <div class="company-list" aria-label="Companies">
                @foreach (CompanyOption company in FilteredCompanies)
                {
                    <button type="button" class="company-row" @onclick="() => OpenCompany(company)">
                        <span class="company-name">@company.Name</span>
                        <span class="company-count">@company.ComplaintCount.ToString("N0") <span class="muted">complaints</span></span>
                    </button>
                }
            </div>
        }
    </section>
}
else
{
    <div class="company-heading">
        <div>
            <p class="eyebrow">Company inspection</p>
            <h1>@CompanyParam</h1>
        </div>
        <a class="change-company" href="">Choose another company</a>
    </div>

    <nav class="workspace-tabs" aria-label="Company workspace">
        <a href="@TabUrl("signals")" class="@(ActiveTab == "signals" ? "selected" : null)" aria-current="@(ActiveTab == "signals" ? "page" : null)">Signals</a>
        <a href="@TabUrl("themes")" class="@(ActiveTab == "themes" ? "selected" : null)" aria-current="@(ActiveTab == "themes" ? "page" : null)">Themes</a>
        <a href="@TabUrl("tickets")" class="@(ActiveTab == "tickets" ? "selected" : null)" aria-current="@(ActiveTab == "tickets" ? "page" : null)">Ticket drafts</a>
        <a href="@TabUrl("complaints")" class="@(ActiveTab == "complaints" ? "selected" : null)" aria-current="@(ActiveTab == "complaints" ? "page" : null)">Find complaints</a>
    </nav>

    @if (busy)
    {
        <p class="muted">Loading @CompanyParam data…</p>
    }
    else if (ActiveTab == "signals")
    {
        <section>
            <h2>Flagged weeks</h2>
            <p class="muted">Weekly complaint volume for @CompanyParam compared with that company’s own recent baseline. Watches are lower-confidence increases; alerts meet the stronger threshold.</p>
            @if (signals.Count == 0)
            {
                <p>No weeks met the watch threshold for this company in the held-out period.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr><th>Tier</th><th>Week of</th><th class="num">Complaints</th><th class="num">Usual level</th><th class="num">Score (z)</th><th>Reason</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var signal in signals)
                            {
                                <tr>
                                    <td><span class="signal-tier @signal.Tier">@signal.Tier</span></td>
                                    <td>@signal.WeekStart</td>
                                    <td class="num">@signal.Count</td>
                                    <td class="num">@signal.BaselineMean.ToString("F1")</td>
                                    <td class="num alert-text">@signal.ZScore.ToString("F1")</td>
                                    <td>@signal.Reason</td>
                                    <td><button @onclick="() => DraftTicket(signal.WeekStart)" disabled="@busy">Draft ticket</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
    else if (ActiveTab == "themes")
    {
        <section>
            <h2>Themes involving @CompanyParam</h2>
            <p class="muted">Complaint counts below are for this company. Open a theme for its overall trend and composition across all companies.</p>
            @if (companyClusters.Count == 0)
            {
                <p>No exported theme associations were found for this company.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Theme</th><th class="num">Company complaints</th><th class="num">Share of theme</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var theme in companyClusters)
                            {
                                <tr>
                                    <td>@theme.Label</td>
                                    <td class="num">@theme.ComplaintCount.ToString("N0")</td>
                                    <td class="num">@ShareOfTheme(theme, SelectedCompany).ToString("P1")</td>
                                    <td><a href="@ClusterUrl(theme)">View theme</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
    else if (ActiveTab == "tickets")
    {
        <section>
            <h2>Ticket drafts</h2>
            @if (tickets.Count == 0)
            {
                <p>No ticket drafts with evidence exclusively from this company.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Status</th><th>Title</th><th>Jira issue</th></tr></thead>
                        <tbody>
                            @foreach (var ticket in tickets)
                            {
                                <tr>
                                    <td><span class="status @ticket.Status.ToLowerInvariant()">@ticket.Status</span></td>
                                    <td><a href="tickets/@ticket.Id?company=@Uri.EscapeDataString(CompanyParam!)">@ticket.Title</a></td>
                                    <td>@(ticket.JiraKey ?? "Not created")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
    else
    {
        <section>
            <h2>Find complaints</h2>
            <p class="muted">Search within @CompanyParam. Similar matches are also restricted to this company.</p>
            <div class="searchbar">
                <label for="q" class="visually-hidden">Search product or issue</label>
                <input id="q" @bind="query" @bind:event="oninput" @onkeydown="OnSearchKey"
                       placeholder="Product, issue, or sub-issue" />
                <button class="primary" @onclick="RunSearch" disabled="@busy">Search</button>
            </div>

            @if (similarTo is not null)
            {
                <h3>Complaints similar to #@similarTo</h3>
                <button @onclick="ClearSimilar">Back to results</button>
                @if (similar.Count == 0)
                {
                    <p>No similar complaints were found for this complaint.</p>
                }
                @foreach (var match in similar)
                {
                    <ComplaintCard C="match.Complaint">
                        <p class="muted">Similarity @match.Score.ToString("F2")</p>
                    </ComplaintCard>
                }
            }
            else if (results is not null)
            {
                <h3>@results.Count @(results.Count == 1 ? "match" : "matches")</h3>
                @if (results.Count == 0)
                {
                    <p>No complaints matched within @CompanyParam.</p>
                }
                @foreach (var complaint in results)
                {
                    <ComplaintCard C="complaint">
                        <button @onclick="() => ShowSimilar(complaint.Id)">Show similar complaints</button>
                    </ComplaintCard>
                }
            }
        </section>
    }
}

@code {
    [Parameter, SupplyParameterFromQuery(Name = "company")] public string? CompanyParam { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }

    List<CompanyOption> companies = new();
    List<CompanySignal> signals = new();
    List<CompanyCluster> companyClusters = new();
    List<Ticket> tickets = new();
    List<Complaint> results = new();
    List<SimilarComplaint> similar = new();
    string companyFilter = "";
    string companyOrder = "most";
    string query = "";
    string? loadedCompany;
    string? loadedDataCompany;
    string? loadedTab;
    string? error;
    long? similarTo;
    bool busy;

    string ActiveTab => TabParam is "themes" or "tickets" or "complaints" ? TabParam : "signals";
    CompanyOption? SelectedCompany => companies.FirstOrDefault(c =>
        string.Equals(c.Name, CompanyParam, StringComparison.OrdinalIgnoreCase));
    List<CompanyOption> FilteredCompanies
    {
        get
        {
            var matches = string.IsNullOrWhiteSpace(companyFilter)
                ? companies
                : companies.Where(c => c.Name.Contains(companyFilter.Trim(), StringComparison.OrdinalIgnoreCase));
            return companyOrder switch
            {
                "fewest" => matches.OrderBy(c => c.ComplaintCount).ThenBy(c => c.Name, StringComparer.OrdinalIgnoreCase).ToList(),
                "name" => matches.OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase).ToList(),
                _ => matches.OrderByDescending(c => c.ComplaintCount).ThenBy(c => c.Name, StringComparer.OrdinalIgnoreCase).ToList(),
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try { companies = await Api.GetCompanies(); }
        catch (Exception e) { error = ApiException.Describe(e); }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(CompanyParam))
        {
            loadedCompany = null;
            return;
        }

        if (!string.Equals(loadedCompany, CompanyParam, StringComparison.Ordinal))
        {
            loadedCompany = CompanyParam;
            results.Clear();
            similar.Clear();
            similarTo = null;
        }
        if (loadedDataCompany == CompanyParam && loadedTab == ActiveTab) return;

        loadedDataCompany = CompanyParam;
        loadedTab = ActiveTab;
        error = null;
        busy = true;
        try
        {
            if (ActiveTab == "signals") signals = await Api.GetCompanySignals(CompanyParam);
            else if (ActiveTab == "themes") companyClusters = await Api.GetCompanyClusters(CompanyParam);
            else if (ActiveTab == "tickets") tickets = await Api.GetTickets(CompanyParam);
        }
        catch (Exception e) { error = ApiException.Describe(e); }
        finally { busy = false; }
    }

    string TabUrl(string tab) => $"?company={Uri.EscapeDataString(CompanyParam!)}&tab={tab}";
    string ClusterUrl(CompanyCluster theme) =>
        $"clusters/{theme.ClusterId}?company={Uri.EscapeDataString(CompanyParam!)}&companyCount={theme.ComplaintCount}";
    static double ShareOfTheme(CompanyCluster theme, CompanyOption? selected) {
        Console.WriteLine(selected?.ComplaintCount);
        return selected is null || theme.ClusterSize == 0 ? 0 : (double)theme.ComplaintCount / selected.ComplaintCount;
    }
    void OpenCompany(CompanyOption selected)
    {
        Nav.NavigateTo($"?company={Uri.EscapeDataString(selected.Name)}&tab=signals");
    }

    async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await RunSearch();
    }

    async Task RunSearch()
    {
        busy = true;
        error = null;
        similarTo = null;
        try { results = await Api.SearchComplaints(query, CompanyParam!); }
        catch (Exception e) { error = ApiException.Describe(e); }
        finally { busy = false; }
    }

    async Task ShowSimilar(long id)
    {
        busy = true;
        error = null;
        try { similar = await Api.GetSimilar(id); similarTo = id; }
        catch (Exception e) { error = ApiException.Describe(e); }
        finally { busy = false; }
    }

    async Task DraftTicket(string weekStart)
    {
        busy = true;
        error = null;
        try
        {
            var ticket = await Api.CreateCompanyDraft(CompanyParam!, weekStart);
            Nav.NavigateTo($"tickets/{ticket.Id}?company={Uri.EscapeDataString(CompanyParam!)}");
        }
        catch (Exception e) { error = ApiException.Describe(e); }
        finally { busy = false; }
    }

    void ClearSimilar() => similarTo = null;
}